{
  "name": "dsh-docgen",
  "version": "1.0.0",
  "description": "docgen — document workshop skill pack: pure-prompt Agent Skills for README generation, PR descriptions, changelogs and code review, installable into dsh (DeepSeek Harness).",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "SKILLS.md",
    "skills",
    "manifest.json",
    "examples",
    "scripts",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "python scripts/validate_skills.py",
    "test": "node --test tests/index.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "agent-skills",
    "documentation",
    "readme",
    "changelog",
    "code-review"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}